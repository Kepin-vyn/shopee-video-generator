# ── Core ──────────────────────────────────────────────────────────────────────
PROJECT_NAME="Shopee Affiliate Batch Video Generator"

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Docker Compose default (service name = db)
DATABASE_URL=postgresql://postgres:postgres@db:5432/shopee_video_db

# Local development override:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopee_video_db

# ── Redis (Celery broker & result backend) ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Local development override:
# REDIS_URL=redis://localhost:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
# IMPORTANT: generate a strong random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-change-in-production-please-replace-me

# JWT expiry: 7 days (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage

# ── Celery Worker ──────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2

# ── Frontend ───────────────────────────────────────────────────────────────────
# Used at build time by Next.js (must match backend public URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production (replace with your actual domain)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
